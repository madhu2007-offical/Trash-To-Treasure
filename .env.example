# MongoDB Atlas Connection String
# Get this from MongoDB Atlas -> Your Cluster -> Connect -> Drivers (Node.js)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/trash-to-treasure?retryWrites=true&w=majority
MONGODB_URI=

# Optional: Custom database name (defaults to 'trash-to-treasure')
MONGODB_DB_NAME=trash-to-treasure

# Gmail / SMTP Email Dispatch Configuration for Real OTPs
# Option 1: Gmail (Use a Google Account "App Password", not your normal login password)
# Generate from: https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_digit_app_password

# Option 2: Custom SMTP (Brevo, SendGrid, Mailgun, AWS SES, etc.)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_login
# SMTP_PASS=your_smtp_password

